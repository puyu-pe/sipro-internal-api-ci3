{
  "name": "puyu-pe/sipro-internal-api-ci3",
  "version": "1.1.0",
  "description": "Lightweight CI3 bridge for sipro internal API",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "puyu-pe/sipro-internal-api-core": "^1.1.0"
  },
  "autoload": {
    "psr-4": {
      "PuyuPe\\SiproInternalApiCi3\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PuyuPe\\SiproInternalApiCi3\\Tests\\": "tests/"
    },
    "files": [
      "tests/Fakes/CoreStubs.php"
    ]
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
