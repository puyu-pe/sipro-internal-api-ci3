{
  "name": "puyu-pe/sipro-internal-api-ci3",
  "version": "2.0.0",
  "description": "Lightweight CI3 bridge for sipro internal API",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "puyu-pe/sipro-internal-api-core": "^2.0.0"
  },
  "autoload": {
    "psr-4": {
      "PuyuPe\\SiproInternalApiCi3\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PuyuPe\\SiproInternalApiCi3\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "codeigniter/framework": "3.1.13",
    "pocketarc/codeigniter": "3.3.0"
  },
  "scripts": {"test": "phpunit"},
  "minimum-stability": "stable",
  "prefer-stable": true
}
